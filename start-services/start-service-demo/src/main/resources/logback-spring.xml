<?xml version="1.0" encoding="UTF-8"?>
<!-- 说明：
    1、日志级别及文件 日志记录采用分级记录，级别与日志文件名相对应，不同级别的日志信息记录到不同的日志文件中。
    2、日志级别可以根据开发环境进行配置
-->
<configuration scan="true" scanPeriod="60 seconds">
    <!-- 引入默认设置 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 编码格式设置 -->
    <property name="ENCODING" value="UTF-8"/>
    <!-- 日志文件的存储地址 -->
    <springProperty scope="context" name="LOG_HOME" source="logging.file.path" defaultValue="./logs"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="application"/>

    <!-- 日志格式 -->
    <property name="NORMAL_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}.%method@%line - %msg%n"/>
    <property name="CONSOLE_LOG_PATTERN" value="%boldMagenta([%d{yyyy-MM-dd HH:mm:ss.SSS}]) %red([%thread]) %boldMagenta(%-5level) %blue(%logger{20}.%method@%line) %msg%n"/>

    <!-- ==========================控制台输出========================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${ENCODING}</charset>
        </encoder>
    </appender>

    <!-- ==========================文件输出策略========================== -->

    <!-- 主应用日志 - 使用 SizeAndTimeBasedRollingPolicy -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${NORMAL_LOG_PATTERN}</pattern>
            <charset>${ENCODING}</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- ERROR日志 - 单独文件 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        <encoder>
            <pattern>${NORMAL_LOG_PATTERN}</pattern>
            <charset>${ENCODING}</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>


    <!-- ==========================异步输出提升性能========================== -->
    <appender name="ASYNC-APP" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>20</discardingThreshold> <!-- 队列剩余20%时丢弃DEBUG/INFO日志 -->
        <queueSize>2048</queueSize> <!-- 增大队列 -->
        <neverBlock>true</neverBlock>
        <appender-ref ref="APP_FILE"/>
    </appender>

    <appender name="ASYNC-ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>20</discardingThreshold> <!-- 队列剩余20%时丢弃DEBUG/INFO日志 -->
        <queueSize>1024</queueSize>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <!-- ==========================日志级别配置========================== -->
    <logger name="cn.muziseo" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="java.sql.Connection" level="INFO"/>
    <logger name="com.apache.ibatis" level="INFO"/>



    <!-- ==========================环境特定配置========================== -->

    <!-- 开发环境：打印控制台和输出到文件 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC-APP"/>
            <appender-ref ref="ASYNC-ERROR"/>
        </root>
    </springProfile>

    <!-- 测试环境：打印控制台和输出到文件 -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC-APP"/>
            <appender-ref ref="ASYNC-ERROR"/>
        </root>
    </springProfile>

    <!-- 生产环境和预发布环境：只打印WARN及以上级别的日志到控制台，其他日志输出到文件 -->
    <springProfile name="pre,prod">
        <property name="PROD_PATTERN"
                  value="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%thread] %-5level %logger{20}.%method@%line - %msg%n"/>

        <appender name="PROD_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>WARN</level>
            </filter>
            <encoder>
                <pattern>${PROD_PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="ASYNC-APP"/>
            <appender-ref ref="ASYNC-ERROR"/>
            <appender-ref ref="PROD_CONSOLE"/>
        </root>
    </springProfile>
</configuration>